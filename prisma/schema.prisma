generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  STUDENT
}

enum EquipmentStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  LOST
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum UsageStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum MaintenanceStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  passwordHash         String
  phone                String?
  avatarUrl            String?
  studentId            String?       @unique
  employeeId           String?       @unique
  department           String?
  role                 Role          @default(STUDENT)
  isActive             Boolean       @default(true)
  emailVerified        Boolean       @default(false)
  mustChangePassword   Boolean       @default(false)
  
  reservations         Reservation[] @relation("ReservationOwner")
  reviewedReservations Reservation[] @relation("ReservationReviewer")
  usageLogs            UsageLog[]    @relation("EquipmentUser")
  issuedUsageLogs      UsageLog[]    @relation("EquipmentIssuer")
  receivedUsageLogs    UsageLog[]    @relation("EquipmentReceiver")
  reportedMaintenance  Maintenance[] @relation("MaintenanceReporter")
  assignedMaintenance  Maintenance[] @relation("MaintenanceAssignee")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([isActive])
  @@index([department])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  iconUrl     String?
  isActive    Boolean @default(true)

  equipment Equipment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

model Location {
  id          String  @id @default(uuid())
  name        String
  building    String?
  floor       String?
  roomNumber  String?
  description String?
  isActive    Boolean @default(true)

  equipment Equipment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name, building, roomNumber])
  @@index([isActive])
  @@index([deletedAt])
  @@map("locations")
}

model Equipment {
  id           String  @id @default(uuid())
  name         String
  serialNumber String  @unique
  assetTag     String? @unique
  modelNumber  String?
  manufacturer String?
  description  String?

  status    EquipmentStatus    @default(AVAILABLE)
  condition EquipmentCondition @default(GOOD)

  categoryId String
  locationId String

  purchaseDate   DateTime?
  purchasePrice  Decimal?  @db.Decimal(12, 2)
  warrantyExpiry DateTime?
  imageUrl       String?
  qrCode         String?   @unique
  barcode        String?   @unique
  metadata       Json?

  requiresApproval  Boolean @default(true)
  maximumUsageHours Int?
  isActive          Boolean @default(true)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reservations Reservation[]
  usageLogs    UsageLog[]
  maintenance  Maintenance[]
  attachments  EquipmentAttachment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([status])
  @@index([condition])
  @@index([categoryId])
  @@index([locationId])
  @@index([isActive])
  @@index([status, categoryId])
  @@index([status, locationId])
  @@index([deletedAt])
  @@map("equipment")
}

model EquipmentAttachment {
  id          String  @id @default(uuid())
  equipmentId String
  title       String
  fileUrl     String
  fileType    String?
  fileSize    Int?
  description String?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@map("equipment_attachments")
}

model Reservation {
  id          String @id @default(uuid())
  userId      String
  equipmentId String

  startTime DateTime
  endTime   DateTime
  purpose   String
  notes     String?

  status             ReservationStatus @default(PENDING)
  rejectionReason    String?
  cancellationReason String?

  reviewedById String?
  reviewedAt   DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?

  user User @relation("ReservationOwner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reviewedBy User? @relation("ReservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  usageLog UsageLog?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([equipmentId])
  @@index([reviewedById])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([equipmentId, startTime, endTime])
  @@index([userId, status])
  @@map("reservations")
}

model UsageLog {
  id            String  @id @default(uuid())
  userId        String
  equipmentId   String
  reservationId String? @unique

  status UsageStatus @default(ACTIVE)

  startTime          DateTime  @default(now())
  expectedReturnTime DateTime?
  endTime            DateTime?

  purpose      String
  issuedById   String?
  returnedToId String?

  checkoutCondition EquipmentCondition  @default(GOOD)
  returnCondition   EquipmentCondition?

  checkoutNotes String?
  returnNotes   String?
  overdueReason String?

  lateFee   Decimal? @db.Decimal(10, 2)
  damageFee Decimal? @db.Decimal(10, 2)
  feePaid   Boolean  @default(false)

  user User @relation("EquipmentUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  issuedBy User? @relation("EquipmentIssuer", fields: [issuedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  returnedTo User? @relation("EquipmentReceiver", fields: [returnedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([equipmentId])
  @@index([issuedById])
  @@index([returnedToId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([expectedReturnTime])
  @@index([equipmentId, status])
  @@index([userId, status])
  @@map("usage_logs")
}

model Maintenance {
  id           String  @id @default(uuid())
  equipmentId  String
  reportedById String
  assignedToId String?

  title       String
  description String

  status   MaintenanceStatus   @default(REPORTED)
  priority MaintenancePriority @default(MEDIUM)

  technicianName  String?
  serviceProvider String?
  estimatedCost   Decimal? @db.Decimal(12, 2)
  actualCost      Decimal? @db.Decimal(12, 2)

  reportedAt  DateTime  @default(now())
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  resolution         String?
  cancellationReason String?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reportedBy User @relation("MaintenanceReporter", fields: [reportedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignedTo User? @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([reportedAt])
  @@index([equipmentId, status])
  @@map("maintenance_records")
}
